# Tudo aqui é opcional: sem .env, valem os valores do código (frontend/src/services/assinatura.ts).
# No site publicado, cadastre em Vercel > Project > Settings > Environment Variables e faça Redeploy.

# Links de checkout da Cakto de cada plano (só para trocar os links que já estão no código)
# VITE_CAKTO_LINK_MENSAL=https://pay.cakto.com.br/SEU_LINK_MENSAL
# VITE_CAKTO_LINK_ANUAL=https://pay.cakto.com.br/SEU_LINK_ANUAL

# Chave de bloqueio: ligada por padrão. false desliga a tela de renovação (ninguém é bloqueado).
# VITE_ASSINATURA_OBRIGATORIA=false
