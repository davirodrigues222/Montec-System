# Copie para .env e preencha. No servidor de hospedagem (Vercel, Netlify...), cadastre as mesmas
# variáveis nas configurações do projeto.

# Links de checkout da Cakto de cada plano (Produtos > oferta > link de pagamento)
VITE_CAKTO_LINK_MENSAL=https://pay.cakto.com.br/SEU_LINK_MENSAL
VITE_CAKTO_LINK_ANUAL=https://pay.cakto.com.br/SEU_LINK_ANUAL

# Chave de bloqueio: true mostra a tela de renovação para contas sem assinatura ativa.
# Deixe false até executar a migração 20261027090000_assinaturas_saas.sql e testar o webhook.
VITE_ASSINATURA_OBRIGATORIA=false
